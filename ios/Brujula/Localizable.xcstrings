            "value": "This deletes your local scores, notes, and check-ins and turns off reminders. Export a backup first if you want to keep them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borra las puntuaciones, las notas y las evaluaciones locales y desactiva los recordatorios. Exporta una copia antes si quieres conservarlas."
          }
        }
      }
    },
