    "Backups include your notes and are not encrypted by Brújula. They work on iPhone and Android.": {
      "comment": "iPhone interface. Preserve line breaks.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups include your notes and are not encrypted by Brújula. They work on iPhone and Android."
