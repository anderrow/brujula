    "Brújula stores scores, notes, history, and reminder settings in protected files inside the app. These files are excluded from automatic device backups. The app does not collect or send your reflections.": {
      "comment": "iPhone interface. Preserve line breaks.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brújula stores scores, notes, history, and reminder settings in protected files inside the app. These files are excluded from automatic device backups. The app does not collect or send your reflections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brújula guarda las puntuaciones, las notas, el historial y los ajustes del recordatorio en archivos protegidos dentro de la app. Esos archivos quedan fuera de las copias automáticas del dispositivo. La app no recopila ni envía tus reflexiones."
          }
        }
      }
    },
    "Reminders are off by default. If you enable one, iOS schedules it locally. Notifications never include scores or notes.": {
      "comment": "iPhone interface. Preserve line breaks.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders are off by default. If you enable one, iOS schedules it locally. Notifications never include scores or notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios están desactivados por defecto. Si activas uno, iOS lo programa en el dispositivo. Las notificaciones nunca incluyen puntuaciones ni notas."
          }
        }
      }
    },
    "Retention and deletion": {
      "comment": "iPhone interface. Preserve line breaks.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retention and deletion"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservación y borrado"
          }
        }
      }
    },
    "Use Settings → Clear data and start fresh or remove the app to delete its local data. Exported backups are separate. You choose where to save them and are responsible for deleting them.": {
      "comment": "iPhone interface. Preserve line breaks.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Settings → Clear data and start fresh or remove the app to delete its local data. Exported backups are separate. You choose where to save them and are responsible for deleting them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Ajustes → Borrar datos y empezar de cero, o elimina la app, para borrar sus datos locales. Las copias exportadas son independientes. Tú eliges dónde guardarlas y eres responsable de borrarlas."
          }
        }
      }
    },
    "Contact": {
